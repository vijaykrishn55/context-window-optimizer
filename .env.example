# Groq is the default remote provider. Never commit a real API key.
GROQ_API_KEY=
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-20b
# GPT-OSS 20B and 120B are both supported model IDs on Groq.
# LLM_MODEL=openai/gpt-oss-120b

# Context cap should leave room for output and provider overhead.
CONTEXT_WINDOW_TOKENS=131072
PROMPT_BUDGET_TOKENS=120000
TOKENIZER_MODEL=gpt-4o
REQUEST_TIMEOUT_SECONDS=60
